{
  "name": "@dsh-external/dsh-of-your-own",
  "version": "0.3.0",
  "description": "/fuck — read your Claude Code & Codex conversation history in parallel, analyze your preferences and tool habits, migrate them into DSH as a persisted profile, and keep remembering them.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LaplaceYoung/dsh-of-your-own.git"
  },
  "homepage": "https://github.com/LaplaceYoung/dsh-of-your-own",
  "bugs": {
    "url": "https://github.com/LaplaceYoung/dsh-of-your-own/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "displayName": "dsh-of-your-own",
      "summary": {
        "en": "/fuck — scan Claude Code & Codex history and migrate your preferences natively into DSH.",
        "zh-CN": "/fuck — 扫描 Claude Code、Codex 历史，把你的偏好原生迁进 DSH。"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
