{
  "name": "@dsh-external/dsh-of-your-own",
  "version": "0.1.0",
  "description": "/fuck — read your Claude Code & Codex conversation history in parallel, analyze your preferences and tool habits, migrate them into DSH as a persisted profile, and keep remembering them.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "commands": [
        "fuck",
        "sessions",
        "resume",
        "forget"
      ],
      "tools": [
        "my_profile",
        "my_commands"
      ],
      "skills": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
