{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"],
    "paths": {
      "@deepseek-ai/cordis": ["./types/cordis.d.ts"]
    }
  },
  "include": ["src"]
}
